{
  "manifest_version": 3,
  "name": "Blockfacho auto",
  "version": "1.4.0",
  "homepage_url": "https://github.com/Fredersen/block-facho-extension",
  "description": "Bloque automatiquement sur X les comptes de la liste onbloquelextremedroite.fr, à un rythme modéré.",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://x.com/*",
    "https://www.onbloquelextremedroite.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blockfacho auto",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
